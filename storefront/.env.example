#################################################
# Storefront Environment Variables (copy to .env.local)
#################################################

# Backend connection (ensure CORS on backend allows this origin)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base storefront URL (used for canonical / redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Region fallback (used when geo detection fails)
NEXT_PUBLIC_DEFAULT_REGION=us

# Feature flags
NEXT_PUBLIC_FEATURE_SEARCH_ENABLED=true
# SKIP_BUILD_FETCH=1   # Uncomment to skip build-time product/collection fetches in CI

# Search (Meilisearch)
NEXT_PUBLIC_SEARCH_ENDPOINT=http://127.0.0.1:7700
NEXT_PUBLIC_SEARCH_API_KEY=masterKey
NEXT_PUBLIC_INDEX_NAME=products

# Stripe (public key)
NEXT_PUBLIC_STRIPE_KEY=pk_test_stripe_public_key

# PayPal (client id)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=paypal_client_id

# Optional future flags
# NEXT_PUBLIC_SOME_FLAG=1