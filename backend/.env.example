###############################################
# Backend Environment Variables (copy to .env) #
###############################################

# Core
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa  # Must exist
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
BACKEND_PUBLIC_URL=http://localhost:9000

# Seed admin user (used by seeding scripts / first run)
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=supersecret

# CORS (comma separated origins)
ADMIN_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
AUTH_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
STORE_CORS=http://localhost:8000,https://docs.medusajs.com

# Worker Mode: server | worker | shared
MEDUSA_WORKER_MODE=shared
# Disable admin build (true/false)
MEDUSA_DISABLE_ADMIN=false

# Redis (optional - if unset uses in-memory / fake redis)
# REDIS_URL=redis://localhost:6379

# File Storage - MinIO (optional, falls back to local storage when unset)
# MINIO_ENDPOINT=127.0.0.1
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=medusa-media

# Email Providers (choose ONE provider configuration)
# Resend
# RESEND_API_KEY=your_resend_key
# RESEND_FROM_EMAIL=store@example.com
# SendGrid
# SENDGRID_API_KEY=your_sendgrid_key
# SENDGRID_FROM_EMAIL=store@example.com

# Stripe Payments (optional)
# STRIPE_API_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Meilisearch (optional search)
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_ADMIN_KEY=masterKey

# Railway (optional deployment public domain override)
# RAILWAY_PUBLIC_DOMAIN_VALUE=

# Flags
# MEDUSA_DISABLE_ADMIN=true