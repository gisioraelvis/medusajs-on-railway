{
  "name": "medusa-backend",
  "version": "0.0.2",
  "description": "Medusa 2.0 backend",
  "author": "Elvis Gisiora",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build && node src/scripts/postBuild.js",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "init": "init-backend",
    "start": "init-backend && cd .medusa/server && medusa start --verbose",
    "dev": "medusa develop",
    "email:dev": "email dev --dir=./src/modules/email-notifications/templates --port=3002"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.10.1",
    "@medusajs/cli": "2.10.1",
    "@medusajs/framework": "2.10.1",
    "@medusajs/medusa": "2.10.1",
    "@medusajs/dashboard": "2.10.1",
    "@medusajs/notification-sendgrid": "2.10.1",
    "@medusajs/payment-stripe": "2.10.1",
    "@medusajs/workflow-engine-redis": "2.10.1",
    "@mikro-orm/core": "6.5.1",
    "@mikro-orm/knex": "6.5.1",
    "@mikro-orm/migrations": "6.5.1",
    "@mikro-orm/postgresql": "6.5.1",
    "@react-email/components": "^0.5.1",
    "@rokmohar/medusa-plugin-meilisearch": "1.2.3",
    "awilix": "^12.0.5",
    "medusajs-launch-utils": "^0.0.17",
    "minio": "^8.0.5",
    "pg": "^8.16.3",
    "resend": "6.0.2",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.10.1",
    "@mikro-orm/cli": "6.5.1",
    "@swc/core": "1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "jest": "^30.1.1",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-email": "^4.2.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  }
}
